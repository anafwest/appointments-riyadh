    <section id="PlaceHolderMain_License_divPageContainer" class="page-container">
        <div id="PlaceHolderMain_License_EngineeringOfficeInbox" class="section pt-0 mt-1 mt-md-4 tab-content">
            <div class="container p-0 tab-pane active">
                <div class="card p-lg-4">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 d-lg-flex flex-lg-column justify-content-end">
                                <label class="form-group has-float-label mb-3">
                                    <span id="PlaceHolderMain_License_revtxtLicNo" class="ValidationError" style="display:none;">ارقام فقط</span><span id="PlaceHolderMain_License_txtLicNo_cmpMinFv" class="ValidationError" style="display:none;">يجب الا تقل قيمة الحقل عن 1</span><input name="ctl00$PlaceHolderMain$License$txtLicNo" type="number" maxlength="100" id="PlaceHolderMain_License_txtLicNo" class="form-control" decimal="" step="0.00" maxlength="100" style="direction:rtl;" /><span id="PlaceHolderMain_License_rfvtxtLicNo" class="ValidationError" style="display:none;">*</span><br /><span id="PlaceHolderMain_License_revLetterstxtLicNo" class="ValidationError" style="display:none;">لا يسمح بإدخال الرموز</span>
                                    <span>رقم الرخصة </span>
                                </label>
                            </div>
                            <div class="col-md-4">
                                <label class="form-group has-float-label mb-3">
                                    <span id="PlaceHolderMain_License_revtxtLicYear" class="ValidationError" style="display:none;">ارقام فقط</span><span id="PlaceHolderMain_License_txtLicYear_cmpMinFv" class="ValidationError" style="display:none;">يجب الا تقل قيمة الحقل عن 1</span><input name="ctl00$PlaceHolderMain$License$txtLicYear" type="number" maxlength="10" id="PlaceHolderMain_License_txtLicYear" class="form-control" number="" maxlength="10" style="direction:rtl;" /><span id="PlaceHolderMain_License_rfvtxtLicYear" class="ValidationError" style="display:none;">*</span><br /><span id="PlaceHolderMain_License_revLetterstxtLicYear" class="ValidationError" style="display:none;">لا يسمح بإدخال الرموز</span>
                                    <span>سنة الرخصة</span>
                                </label>
                            </div>
                            <div class="col-md-4">
                                <label class="form-group has-float-label mb-3">
                                    <select name="ctl00$PlaceHolderMain$License$drpLicenseType" onchange="javascript:setTimeout(&#39;__doPostBack(\&#39;ctl00$PlaceHolderMain$License$drpLicenseType\&#39;,\&#39;\&#39;)&#39;, 0)" id="PlaceHolderMain_License_drpLicenseType" class="form-control select2 line">

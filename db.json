52b627c.pdf"},{"name":"1.pdf","type":"application/pdf","size":238104,"url":"https://raw.githubusercontent.com/anafwest/appointments-riyadh/main/attachments/1792496704645-2-9285806adc.pdf","path":"attachments/1792496704645-2-9285806adc.pdf"},{"name":"سجل شركة سمايا الجود.pdf","type":"application/pdf","size":1634332,"url":"https://raw.githubusercontent.com/anafwest/appointments-riyadh/main/attachments/1792496704645-3-67b55137e7.pdf","path":"attachments/1792496704645-3-67b55137e7.pdf"},{"name":"خطاب توجيه.pdf","type":"application/pdf","size":248591,"url":"https://raw.githubusercontent.com/anafwest/appointments-riyadh/main/attachments/1792496704645-4-9d8f60efd4.pdf","path":"attachments/1792496704645-4-9d8f60efd4.pdf"}],"templateSaved":true,"templateDate":"2026-10-21T06:30:36.945Z","statementBy":"إدارة شئون الأراضي","statementDate":"2026-10-21T07:18:26.871Z","statementSent":true,"completed":true,"toDeptNote":false,"directorOpinionBy":"المدير العام","directorOpinionAt":"2026-10-25T07:15:21.044Z","signed":true,"signedBy":"المدير العام","signedAt":"2026-10-27T09:14:03.861Z","updatedAt":1793264824498},{"number":"DMV-161020269786","name":"ماجد هادي علي القحطاني","idNumber":"1067997039","subject":"ارغب لقاء المهندس المسؤول عن اصدار تراخيص التشغيل للمواقع التجارية للطلب رقم 48278178989 ببلدي التابع للرخص التجاريه","requestText":"ارغب لقاء المهندس المسؤول عن اصدار تراخيص التشغيل للمواقع التجارية للطلب رقم 48278178989 ببلدي التابع للرخص التجاريه","date":"2026-10-26","time":"10:45","phone":"0583332020","meetingType":"حضوري","department":"إدارة الرخص التجارية والإستثمارية","statement":"طلب اصدار رخصة تجارية لنشاط محطة فئة ب والطلب احيل للمراقب مثل وتم الخروج على الموقع من المراقب فيصل محمد بن غازي النفيعي وملاحظته: غير مطابق عدم توفير خدمة الماء والهواء للمحطة وعدم توفير كاميرات مراقبة وتم اعادة الطلب للمستفيد لمعالجة الملاحظات\n وتم احالة الطلب للمراقب مثل خالد عبدالله مبارك العجمى بعد اعادة الطلب من قبل المستفيد لتأكد من معالجة الملاحظات السابقة وبعد خروج المراقب افاد بوجود ملاحظات التالية: غير مطابق يجب تغطية تمديدات الكهرب - يجب توفير مصلى حسب دليل الارشادات للمحطات الوقود وتم اعادة الطلب للمستفيد لمعالجة الملاحظات الجديدة \nوتم اعادة الطلب من المستفيد واحيل الطلب للمراقب ومازال الطلب لدى المراقب حتى تاريخه. \nعلما ان (المصلى) حسب لائحة اشتراطات المحطات وزارة الطاقة (اختيارية) والمراقب استند الى  الدليل الارشادي في بطاقة النشاط في منصة بلدي وتم ارسال ملاحظة  لمراقبي مثل بأن يتم الاعتماد على لائحة اشتراطات المحطات لوزارة الطاقة وذلك عن طريق الواتساب للقروب الخاص بهم من قبلنا (مرفق حركة الطلب)\n- تم اعتماد الطلب بتاريخ 2026/10/22م وحالته في انتظار موافقة الدفاع المدني","directorOpinion":"تم الشرح للمكتب وتوضيح الملاحظات","attachments":"يوجد مرفقات","status":"تم الحل وانهاء الطلب","id":1792573766134,"templateSaved":true,"templateDate":"2026-10-21T10:24:07.857Z","statementBy":"إدارة الرخص التجارية والإستثمارية","statementDate":"2026-10-25T08:01:03.690Z","statementSent":true,"completed":true,"files":[{"name":"لقطة للللللللشاشة 2026-10-21 140104.png","type":"image/png","size":73108,"url":"https://raw.githubusercontent.com/anafwest/appointments-riyadh/main/attachments/1792573766134-1-f33695fc8c.png","path":"attachments/1792573766134-1-f33695fc8c.png"},{"name":"لقطة شاشة 2026-10-25 105736.png","type":"image/png","size":158980,"url":"https://raw.githubusercontent.com/anafwest/appointments-riyadh/main/attachments/1792573766134-2-92b4ec1eea.png","path":"attachments/1792573766134-2-92b4ec1eea.png"}],"toDeptNote":false,"directorOpinionBy":"المدير العام","directorOpinionAt":"2026-10-27T08:36:08.964Z","signed":true,"returnedBy":"المدير العام","returnedAt":"2026-10-25T07:42:15.946Z","signedBy":"المدير العام","signedAt":"2026-10-27T09:14:13.460Z","updatedAt":1793264824498},{"number":"DMV-201020261313","name":"محمد حسين علي المالكي","idNumber":"1069510384","subject":"نرغب في مقابلة رئيس قسم رخص البناء بقطاع غرب مدينة الرياض لمناقشة ملاحظات الطلب BLS-LR26278903 إصدار رخصة بناء للمالك عبدالمحسن ابراهيم عيسى الضعيان حتى نتمكن من استكمال المعاملة  ( ملاحظه : ايميل المكتب الهندسي awlcon.co@gmail.com )","requestText":"نرغب في مقابلة رئيس قسم رخص البناء بقطاع غرب مدينة الرياض لمناقشة ملاحظات الطلب BLS-LR26278903 إصدار رخصة بناء للمالك عبدالمحسن ابراهيم عيسى الضعيان حتى نتمكن من استكمال المعاملة","date":"2026-10-27","time":"10:30","phone":"0557205527","meetingType":"حضوري","department":"إدارة رخص البناء","statement":"تم عمل اجتماع مع المكتب الهندسي وتم توضيح بعض الملاحظات الفنيه المتكرره لدى المكتب الهندسي التي تخص غرفة النفايات , ارتفاع الستره و تصميم الواجهه ،وتم افهامهم الملاحظات وطلب اعادة رفع المخططات بعد التعديل المطلوب .","directorOpinion":"","attachments":"لا توجد مرفقات","status":"","id":1792574013120,"templateSaved":true,"templateDate":"2026-10-21T09:40:52.455Z","statementBy":"إدارة رخص البناء","statementDate":"2026-10-25T07:45:19.367Z","statementSent":true,"completed":true,"thread":[{"by":"مكتب المدير العام","role":"admin","text":"ايميل المكتب الهندسي awlcon.co@gmail.com","at":"2026-10-21T11:14:07.635Z"},{"by":"مكتب المدير العام","role":"admin","text":"تم ارفاق الايميل","at":"2026-10-22T09:48:25.877Z"}],"withOffice":false,"toDeptNote":true,"returnedBy":"مكتب المدير العام","returnedAt":"2026-10-22T09:48:25.877Z","files":[],"updatedAt":1793264824498},{"number":"DMV-19102026493","name":"زيد محمد فهد بن سليطين","idNumber":"1087867964","subject":"لموضوع: استفسار بشأن ملاحظات طلب إصدار رخصة بناء رقم (BLS-LR264074)  نرغب في حجز موعد مع المختصين لدى أمانة منطقة الرياض لمناقشة بعض الملاحظات الواردة على طلب إصدار رخصة البناء، والاستفسار عن آلية تطبيق بعض الاشتراطات البلدية، خصوصًا ما يتعلق بمبنى الدرايف ثرو .  وذلك بهدف توضيح المتطلبات الفنية والتنظيمية والتأكد من معالجتها بالشكل الصحيح قبل إعادة تقديم المخططات المعدلة، بما يضمن استيفاء جميع الاشتراطات وتسريع إجراءات إصدار الرخصة.","requestText":"لموضوع: استفسار بشأن ملاحظات طلب إصدار رخصة بناء رقم (BLS-LR264074)\n\nنرغب في حجز موعد مع المختصين لدى أمانة منطقة الرياض لمناقشة بعض الملاحظات الواردة على طلب إصدار رخصة البناء، والاستفسار عن آلية تطبيق بعض الاشتراطات البلدية، خصوصًا ما يتعلق بمبنى الدرايف ثرو .\n\nوذلك بهدف توضيح المتطلبات الفنية والتنظيمية والتأكد من معالجتها بالشكل الصحيح قبل إعادة تقديم المخططات المعدلة، بما يضمن استيفاء جميع الاشتراطات وتسريع إجراءات إصدار الرخصة.","date":"2026-10-27","time":"10:45","phone":"0566626276","meetingType":"حضوري","department":"إدارة رخص البناء","statement":"الطلب لايزال لدى المكتب الهندسي حيث يتم رفع المخططات بعد التعديل في الطلب وذلك لتتم مراجعتها من قبل المهندس المدقق وفي حال وجود اي ملاحظات سيتم ذكرها في الطلب واعادته للمكتب الهندسي / كما نفيدكم انه تم عمل تحديد موعد مناقشة مع المكتب الهندسي ولم يتم حضور المكتب للمناقشة وعليه تم اغلاق الموعد المحدد .","directorOpinion":"تم التوضيح للمكتب الهندسي والمالك","attachments":"لا توجد مرفقات","status":"تم الحل وانهاء الطلب","id":1792586932247,"templateSaved":true,"templateDate":"2026-10-22T09:14:19.702Z","statementBy":"إدارة رخص البناء","statementDate":"2026-10-27T08:05:05.150Z","statementSent":true,"completed":true,"thread":[{"by":"إدارة رخص البناء","role":"dept","text":"نأمل تزويدنا بالبريد الالكتروني الخاص بالمكتب الهندسي المالك للطلب وذلك لتنسيق موعد ومناقشة المطلوب مع الموظف المختص لدينا .","at":"2026-10-22T09:49:57.461Z"},{"by":"مكتب المدير العام","role":"admin","text":"ايميل المكتب الهندسي info@itaec.sa","at":"2026-10-22T09:53:44.598Z"}],"withOffice":false,"toDeptNote":true,"returnedBy":"مكتب المدير العام","returnedAt":"2026-10-22T09:53:44.598Z","directorOpinionBy":"المدير العام","directorOpinionAt":"2026-10-27T08:36:31.447Z","signed":true,"signedBy":"المدير العام","signedAt":"2026-10-27T08:36:37.198Z","files":[],"updatedAt":1793264824498},{"number":"DMV-131020268773","name":"محمد بله الامين احمد","idNumber":"2505520219","subject":"الموضوع / تجديد رخصة البناء رقم 11136 عام 1441 حي المهدية","requestText":"نفيدكم بأن المعاملة تجديد وتعديل رخصة بناء وبان المالك يرغب باستكمال بناء الدور الأول والملحق العلوي\nمن الزيارة من قبل المراقب الفني من قبلكم وجد نقص في الارتدادات مرفق التقرير الفني والمخططات وتم\nالاطلاع على التقرير من طرفكم وجات ملاحظ